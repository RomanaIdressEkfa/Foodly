# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodly?retryWrites=true&w=majority

# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --print-secret` locally, or the webhook's signing secret in the Stripe dashboard once deployed
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute image URLs for Stripe Checkout and as the redirect origin.
# Local dev: http://localhost:5173   Production: https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:5173

# Optional: seed.js will create/promote this user to admin when you run `npm run seed`
ADMIN_EMAIL=admin@foodly.com
ADMIN_PASSWORD=ChangeMe123!
